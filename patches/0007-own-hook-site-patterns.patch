+/// A byte pattern: `bytes` with the positions in `open` matching anything.
+const fn pat<const N: usize>(bytes: [u8; N], open: &[usize]) -> [Option<u8>; N] {
+    let mut out = [None; N];
+    let mut i = 0;
+    while i < N {
+        out[i] = Some(bytes[i]);
+        i += 1;
+    }
+    let mut k = 0;
+    while k < open.len() {
+        out[open[k]] = None;
+        k += 1;
+    }
+    out
+}
