+/// The text of the stage tables, one block per registering script (a mission, or a helper of it): the one that
+/// registered last comes last (`checkpoint #<n>` counts in it). Per stage: its place, the hash (and label), the
+/// items the title asked for under it, how often it was registered, and whether a jump to it was tested
+/// (only known for the Chapter 1 ten).
+pub(crate) fn table_text(tables: &[natives::StageTable], hooked: bool) -> String {
+    if tables.is_empty() {
+        return if hooked { "stage table: no mission has registered stages yet (only a mission start does, not a retry)".into() } else { "stage table: not seen: needs VICTORY_NATIVES and MISSION_STAGE_ADD in the names file".into() };
+    }
+    let mut s = String::new();
+    for (k, t) in tables.iter().enumerate() {
+        if k > 0 {
+            s.push('\n');
+        }
+        s.push_str(&format!("stage table of script {:#010x}{}: {} stages in the order the title registered them", t.mission, if k + 1 == tables.len() { " (registered last)" } else { "" }, t.stages.len()));
+        for (i, st) in t.stages.iter().enumerate() {
+            let known = TEN.iter().position(|k| k.0 == st.stage);
+            let tested = known.is_some_and(|k| TEN[k].1);
+            s.push_str(&format!(
+                "\n  #{} {}  items {}  registered {}x{}",
+                i + 1,
+                name(st.stage),
+                st.items,
+                st.regs,
+                if tested { "  jump tested" } else { "" },
+            ));
+        }
+    }
+    s
+}
+
+/// One line for the logs: a stage registered, or the table's summary.
+pub(crate) fn news_line(n: &natives::TableNews, tables: &[natives::StageTable]) -> Option<String> {
+    let m = tables.iter().find(|m| m.mission == n.mission)?;
+    Some(match n.stage {
+        Some(i) => {
+            let st = m.stages.get(i)?;
+            format!("stage table {:#010x} #{}: {}{}", m.mission, i + 1, name(st.stage), if n.again { " registered again" } else { "" })
+        }
+        None => {
+            let order: Vec<String> = m.stages.iter().map(|s| format!("{:#010x}", s.stage)).collect();
+            format!("stage table {:#010x}: {} stages: {} (items {})", m.mission, m.stages.len(), order.join(" "), m.stages.iter().map(|s| s.items.to_string()).collect::<Vec<_>>().join(","))
+        }
+    })
+}
