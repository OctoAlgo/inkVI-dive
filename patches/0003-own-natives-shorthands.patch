+pub fn shorthand(cmd: &str, args: &[&str], marks: &std::path::Path, known: &dyn Fn(&str) -> bool) -> Result<(Vec<String>, After), String> {
+    let num = |i: usize, what: &str| args.get(i).and_then(|w| w.parse::<f32>().ok()).filter(|v| v.is_finite()).ok_or_else(|| format!("bad or missing {what}"));
