+    /// A fake process: one 4 KB page of memory at 0x10000 (read-write),
+    /// an "image" at 0x140000000 holding a global pointer and the clock.
+    struct Fake {
+        pages: RefCell<HashMap<usize, Vec<u8>>>,
+    }
+    const HEAP: usize = 0x10000;
+    const IMAGE: usize = 0x1_4000_0000;
+    impl Fake {
+        fn new() -> Fake {
+            let mut pages = HashMap::new();
+            pages.insert(HEAP, vec![0u8; 0x1000]);
+            pages.insert(IMAGE, vec![0u8; 0xb00_0000]);
+            Fake { pages: RefCell::new(pages) }
+        }
+        fn put(&self, addr: usize, bytes: &[u8]) {
+            assert!(self.write(addr, bytes), "{addr:#x}");
+        }
+    }
+    impl Memory for Fake {
+        fn image_base(&self) -> usize {
+            IMAGE
+        }
+        fn read(&self, addr: usize, len: usize) -> Option<Vec<u8>> {
+            let pages = self.pages.borrow();
+            let (&base, page) = pages.iter().find(|&(b, p)| addr >= *b && addr + len <= *b + p.len())?;
+            Some(page[addr - base..addr - base + len].to_vec())
+        }
+        fn write(&self, addr: usize, bytes: &[u8]) -> bool {
+            let mut pages = self.pages.borrow_mut();
+            let Some((&base, _)) = pages.iter().find(|&(b, p)| addr >= *b && addr + bytes.len() <= *b + p.len()) else { return false };
+            pages.get_mut(&base).unwrap()[addr - base..addr - base + bytes.len()].copy_from_slice(bytes);
+            true
+        }
+        fn regions(&self) -> Vec<Region> {
+            vec![Region { base: HEAP, size: 0x1000, image: false }, Region { base: IMAGE, size: 0x1000, image: true }]
+        }    }
+
+    fn matrix(pos: [f32; 3], heading: f32) -> Vec<u8> {
+        let (a, b) = rows_for_heading(heading);
+        let m: Vec<f32> = [a.as_slice(), b.as_slice(), &[0.0, 0.0, 1.0, 0.0], &[pos[0], pos[1], pos[2], 1.0]].concat();
+        m.iter().flat_map(|v| v.to_le_bytes()).collect()
+    }
+
+    fn executor(dir: &Path) -> Executor<Fake> {
+        let fake = Fake::new();
+        // The ped object at HEAP+0x100 with its transform at +0x60; the
+        // global at img+0x100 points to a holder at HEAP+0x800 whose +8 is
+        // the ped (a two-step chain).
+        fake.put(HEAP + 0x160, &matrix([100.0, 200.0, 30.0], 90.0));
+        fake.put(IMAGE + 0x100, &(HEAP + 0x800).to_le_bytes());
+        fake.put(HEAP + 0x808, &(HEAP + 0x100).to_le_bytes());
+        for (i, v) in [7u32, 45, 12].iter().enumerate() {
+            fake.put(IMAGE + CLOCK_RVA + 0x10 + i * 4, &v.to_le_bytes());
+        }
+        let mut e = Executor::new(fake, dir);
+        e.settings = Settings { chain: vec![IMAGE + 0x100, 0x8], matrix: vec![0x60] };
+        e
+    }
