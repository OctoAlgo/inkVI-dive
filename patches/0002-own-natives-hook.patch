+/// Sets the memory watch (`off` or ranges).
+#[cfg(windows)]
+fn set_memwatch(spec: &str) -> Result<String, String> {
+    let st = STATE.get().ok_or("the natives hook is off")?;
+    let mut t = lock(&st.trace);
+    if spec == "off" {
+        MEMWATCH.store(false, Ordering::Relaxed);
+        t.mem.clear();
+        return Ok("no memory watched".into());
+    }
+    let ranges = parse_ranges(spec, st.base, st.size)?;
+    // SAFETY: ranges inside the mapped image (checked by `parse_ranges`).
+    t.mem = ranges.iter().map(|&(a, l)| (a, unsafe { std::slice::from_raw_parts(a as *const u8, l) }.to_vec())).collect();
+    MEMWATCH.store(!t.mem.is_empty(), Ordering::Relaxed);
+    Ok(format!("watching {} range(s): every change is noted with the native it happened in (ndump -> natives-memwatch.tsv)", t.mem.len()))
+}
+
+/// Parses `+0x<rva>:<len>[,...]` (the memory watch's ranges; inside the image).
+fn parse_ranges(spec: &str, base: usize, size: usize) -> Result<Vec<(usize, usize)>, String> {
+    let mut out = Vec::new();
+    for part in spec.split(',').filter(|p| !p.is_empty()) {
+        let (a, l) = part.split_once(':').ok_or_else(|| format!("{part}: expected +0x<rva>:<len>"))?;
+        let rva = usize::from_str_radix(a.trim_start_matches('+').trim_start_matches("0x"), 16).map_err(|_| format!("bad rva {a}"))?;
+        let len = if let Some(h) = l.strip_prefix("0x") { usize::from_str_radix(h, 16) } else { l.parse() }.map_err(|_| format!("bad length {l}"))?;
+        if len == 0 || len > 0x10000 || rva.checked_add(len).is_none_or(|end| end > size) {
+            return Err(format!("{part}: outside the image or longer than 0x10000"));
+        }
+        out.push((base + rva, len));
+    }
+    Ok(out)
+}
+
+/// Counts the call; for a native's first calls (and for watched natives)
+/// keeps the arguments. Returns the sample's sequence number if one was kept.
+#[cfg(windows)]
+unsafe fn before(st: &State, ctx: &Ctx, handler: usize, sctx: usize) -> Option<(u64, bool)> {
+    let seq = SEQ.fetch_add(1, Ordering::Relaxed) + 1;
+    let rva = handler.wrapping_sub(st.base);
+    // SAFETY: the interpreter's context.
+    let script = unsafe { script_id(sctx) };
+    let mut t = lock(&st.trace);
+    *t.scripts.entry(script).or_default() += 1;
+    // SAFETY: no arguments, no failure.
+    *t.threads.entry(unsafe { windows_sys::Win32::System::Threading::GetCurrentThreadId() }).or_default() += 1;
+    let watched = !t.watch.is_empty() && t.watch.contains(&rva) && t.watched.len() < WATCH_MAX;
+    let stat = t.stats.entry(rva).or_default();
+    stat.count += 1;
+    if stat.count == 1 {
+        stat.first_seq = seq;
+        stat.argc = ctx.argc;
+        stat.retc = ctx.retc;
+    }
+    let keep = stat.samples.len() < SAMPLES;
+    let logging = LOGGING.load(Ordering::Relaxed) && t.log.len() < LOG_MAX;
+    if logging {
+        let mut a = [0u64; 4];
+        if !ctx.args.is_null() {
+            for i in 0..(ctx.argc as usize).min(4) {
+                // SAFETY: `argc` slots on the script's stack.
+                a[i] = unsafe { ctx.args.add(i).read_unaligned() };
+            }
+        }
+        t.log.push((seq, rva as u32, script, ctx.argc, a, 0));
+    }
+    if !keep && !watched {
+        return if logging { Some((seq, false)) } else { None };
+    }
+    let stat = t.stats.entry(rva).or_default();
+    let n = (ctx.argc as usize).min(12);
+    // SAFETY: `argc` slots on the script's stack.
+    let args: Vec<u64> = if ctx.args.is_null() { Vec::new() } else { unsafe { std::slice::from_raw_parts(ctx.args, n).to_vec() } };
+    let strs = args.iter().enumerate().filter_map(|(i, &a)| string_at(a).map(|s| (i, s))).collect();
+    let sample = Sample { seq, ms: st.started.elapsed().as_millis() as u64, script, args, strs, ret: Vec::new() };
+    if keep {
+        stat.samples.push(sample.clone());
+    }
+    if watched {
+        t.watched.push((rva, sample));
+    }
+    Some((seq, watched))
+}
+
+/// Runs the queued calls (all of them, in order).
+#[cfg(windows)]
+unsafe fn run_queue(st: &State, sctx: usize) {
+    // SAFETY: the interpreter's context.
+    let script = unsafe { script_id(sctx) };
+    loop {
+        let (call, args) = {
+            let mut q = lock(&st.queue);
+            if q.only_script != 0 && q.only_script != script {
+                return;
+            }
+            let Some(call) = q.calls.pop_front() else {
+                QUEUED.store(0, Ordering::Relaxed);
+                return;
+            };
+            QUEUED.store(q.calls.len(), Ordering::Relaxed);
+            let mut args: Vec<u64> = Vec::new();
+            for a in &call.args {
+                match a {
+                    Arg::Val(v) => args.push(*v),
+                    Arg::Var(name, None) => args.extend(q.vars.get(name).cloned().unwrap_or_default()),
+                    Arg::Var(name, Some(i)) => args.push(q.vars.get(name).and_then(|v| v.get(*i)).copied().unwrap_or(0)),
+                }
+            }
+            (call, args)
+        };
+        let argc = args.len();
+        let mut slots = args.clone();
+        slots.resize(argc + 16, 0);
+        let mut ret = [0u64; 16];
+        let mut ctx = Ctx { args: slots.as_mut_ptr(), ret: ret.as_mut_ptr(), argc: argc as u32, retc: call.nret as u32 };
+        tracing::info!(id = call.id, script = format_args!("{script:#x}"), "{ENV}: calling {}", call.text);
+        // SAFETY: a native handler of this image (checked when queued), called
+        // as the interpreter calls it, on a script thread.
+        unsafe { std::mem::transmute::<usize, unsafe extern "win64" fn(*mut Ctx)>(st.base + call.rva)(&mut ctx) };
+        let rets = &ret[..call.nret.clamp(1, 16)];
+        let show = |v: &[u64]| v.iter().map(|x| fmt_slot(*x)).collect::<Vec<_>>().join(" ");
+        let mut text = format!("#{} {} -> ret [{}]", call.id, call.text, show(rets));
+        if call.nret == 2 {
+            let f = |v: u64| f32::from_bits(v as u32);
+            text.push_str(&format!(" vec({:.3}, {:.3}, {:.3})", f(ret[0]), f(ret[0] >> 32), f(ret[1])));
+        }
+        if slots[..argc] != args[..] {
+            text.push_str(&format!(" args after [{}]", show(&slots[..argc])));
+        }
+        text.push_str(&format!(" (script {script:#x})"));
+        tracing::info!("{ENV}: {text}");
+        let mut q = lock(&st.queue);
+        if let Some(name) = call.store {
+            q.vars.insert(name, ret[..call.nret.clamp(1, 16)].to_vec());
+        }
+        q.done.insert(call.id, text);
+    }
+}
+
+/// A slot as hex, with its float reading when that is a plain number.
+fn fmt_slot(v: u64) -> String {
+    let f = f32::from_bits(v as u32);
+    if v >> 32 == 0 && v != 0 && f.is_finite() && (1e-4..1e7).contains(&f.abs()) {
+        format!("{v:#x}({f})")
+    } else {
+        format!("{v:#x}")
+    }
+}
+
+/// Parses one `ncall` argument: `123`, `-5`, `0x1f`, `1.5` (a float),
+/// `s:TEXT` (a pointer to the text), `h:TEXT` (its string hash), `$name`,
+/// `$name.<i>`, `buf:<n>` (a pointer to `n` zeroed 8-byte slots).
+pub fn parse_arg(word: &str) -> Result<Arg, String> {
+    parse_args(word).and_then(|v| if v.len() == 1 { Ok(v[0].clone()) } else { Err(format!("{word} is more than one slot")) })
+}
+
+/// A vector's two slots: x in the low and y in the high half of the first, z in the low half of the second.
+pub fn vec_slots(x: f32, y: f32, z: f32) -> [u64; 2] {
+    [u64::from(x.to_bits()) | u64::from(y.to_bits()) << 32, u64::from(z.to_bits())]
+}
+
+/// As [`parse_arg`], plus `v:<x>,<y>,<z>` (a vector: two slots).
+pub fn parse_args(word: &str) -> Result<Vec<Arg>, String> {
+    if let Some(v) = word.strip_prefix("v:") {
+        let f: Vec<f32> = v.split(',').map(|c| c.parse::<f32>().map_err(|_| format!("bad vector {word}"))).collect::<Result<_, _>>()?;
+        let [x, y, z] = f[..] else { return Err(format!("bad vector {word} (v:x,y,z)")) };
+        return Ok(vec_slots(x, y, z).into_iter().map(Arg::Val).collect());
+    }
+    parse_one(word).map(|a| vec![a])
+}
+
+fn parse_one(word: &str) -> Result<Arg, String> {
+    if let Some(v) = word.strip_prefix('$') {
+        return Ok(match v.split_once('.') {
+            Some((name, i)) => Arg::Var(name.to_string(), Some(i.parse().map_err(|_| format!("bad slot in {word}"))?)),
+            None => Arg::Var(v.to_string(), None),
+        });
+    }
+    if let Some(text) = word.strip_prefix("s:") {
+        let mut bytes = text.replace('~', " ").into_bytes();
+        bytes.push(0);
+        return Ok(Arg::Val(Box::leak(bytes.into_boxed_slice()).as_ptr() as u64));
+    }
+    if let Some(text) = word.strip_prefix("h:") {
+        return Ok(Arg::Val(u64::from(joaat(&text.replace('~', " ")))));
+    }
+    if let Some(n) = word.strip_prefix("buf:") {
+        let n: usize = n.parse().map_err(|_| format!("bad size in {word}"))?;
+        return Ok(Arg::Val(Box::leak(vec![0u64; n.clamp(1, 4096)].into_boxed_slice()).as_ptr() as u64));
+    }
+    if let Some(h) = word.strip_prefix("0x") {
+        return u64::from_str_radix(h, 16).map(Arg::Val).map_err(|_| format!("bad number {word}"));
+    }
+    if word.contains('.') || word.contains('e') {
+        return word.parse::<f32>().map(|f| Arg::Val(u64::from(f.to_bits()))).map_err(|_| format!("bad number {word}"));
+    }
+    // An int is a 32-bit slot (negative ones as their 32-bit pattern); larger values fill the slot.
+    word.parse::<i64>()
+        .map(|v| Arg::Val(if v <= i64::from(u32::MAX) { u64::from(v as u32) } else { v as u64 }))
+        .map_err(|_| format!("bad number {word}"))
+}
+
+fn target(st: &State, word: &str) -> Result<usize, String> {
+    let by_hash = |h: u64| st.by_hash.get(&h).copied().ok_or_else(|| format!("no native with hash {h:#x}"));
+    if let Some(r) = word.strip_prefix("+0x") {
+        let rva = usize::from_str_radix(r, 16).map_err(|_| format!("bad rva {word}"))?;
+        return if st.by_rva.contains_key(&rva) { Ok(rva) } else { Err(format!("{word} is not a native handler")) };
+    }
+    if let Some(h) = word.strip_prefix("0x") {
+        return by_hash(u64::from_str_radix(h, 16).map_err(|_| format!("bad hash {word}"))?);
+    }
+    match st.names.get(&word.to_ascii_uppercase()) {
+        Some(h) => by_hash(*h),
+        None => Err(format!("unknown native {word} (a name of {NAMES_ENV}, 0x<hash> or +0x<rva>)")),
+    }
+}
+
+/// What a debug-channel line did.
+pub enum Reply {
+    /// Not one of ours.
+    NotOurs,
+    /// Done now.
+    Now(Result<String, String>),
+    /// Queued: the results of these calls come later ([`result`]).
+    Queued(Vec<u64>, String),
+}
+
+/// One line of the debug channel (`ncall`, `nstat`, `ntrace`, `ndump`, `nmark`, `nwatch`, `nscript`, `nfind`).
+/// `folder` is where `ndump` writes.
+#[cfg(windows)]
+pub fn command(line: &str, folder: &std::path::Path) -> Reply {
+    let words: Vec<&str> = line.split_whitespace().collect();
+    let Some(&cmd) = words.first() else { return Reply::NotOurs };
+    if !matches!(cmd, "ncall" | "nstat" | "ntrace" | "ndump" | "nmark" | "nwatch" | "nscript" | "nfind" | "nhelp" | "npos" | "ntp" | "ntime" | "nwatchmem" | "nlog") {
+        return Reply::NotOurs;
+    }
+    if cmd == "nhelp" {
+        return Reply::Now(Ok("ncall <NAME|0xhash|+0xrva> [ret=<n>] [><var>] [<arg>...] (args: 12, 0x1f, 1.5, s:TEXT, h:TEXT, $var, $var.<i>, buf:<n>; ~ = space) | \
+            nstat | ntrace on|off | ndump | nmark <label> | nwatch <native>|off | nscript <id>|any | nfind <native> | \
+            nwatchmem +0x<rva>:<len>[,...]|off | nlog [<from call> [<to call>]] (needs VICTORY_NATIVES=log) | npos | ntp <x> <y> <z> | ntime <hh> <mm>"
+            .into()));
+    }
+    let Some(st) = STATE.get() else {
+        return Reply::Now(Err(format!("the natives hook is off (set {ENV}=1 or {ENV}=trace)")));
+    };
+    let args = &words[1..];
+    match cmd {
+        "ncall" => match queue_call(st, args) {
+            Ok((id, text)) => Reply::Queued(vec![id], text),
+            Err(e) => Reply::Now(Err(e)),
+        },
+        // Shorthands over the natives named in the names file (tools/natives-names.txt of the inkVI-dive kit).
+        "npos" | "ntp" | "ntime" => {
+            let lines: Vec<String> = match (cmd, args) {
+                ("npos", _) => vec!["PLAYER_PED_ID ret=2 >_ped".into(), "GET_ENTITY_COORDS ret=2 $_ped 0".into(), "GET_CLOCK_HOURS".into(), "GET_CLOCK_MINUTES".into()],
+                ("ntp", [x, y, z]) => vec![
+                    "PLAYER_PED_ID ret=2 >_ped".into(),
+                    // As the title's own scripts call it: heading 0, no flags, 1, -1.
+                    format!("SET_ENTITY_COORDS $_ped v:{x},{y},{z} 0.0 0 1 -1.0"),
+                    "GET_ENTITY_COORDS ret=2 $_ped 0".into(),
+                ],
+                ("ntime", [h, m]) => vec![format!("SET_CLOCK_TIME {h} {m} 0"), "GET_CLOCK_HOURS".into(), "GET_CLOCK_MINUTES".into()],
+                _ => return Reply::Now(Err("npos | ntp <x> <y> <z> | ntime <hh> <mm>".into())),
+            };
+            let (mut ids, mut texts) = (Vec::new(), Vec::new());
+            for l in &lines {
+                let words: Vec<&str> = l.split_whitespace().collect();
+                match queue_call(st, &words) {
+                    Ok((id, text)) => {
+                        ids.push(id);
+                        texts.push(text);
+                    }
+                    Err(e) => return Reply::Now(Err(e)),
+                }
+            }
+            Reply::Queued(ids, texts.join("\n"))
+        }
+        "nlog" => {
+            let num = |i: usize, d: u64| args.get(i).and_then(|w| w.parse::<u64>().ok()).unwrap_or(d);
+            let (from, to) = (num(0, 0), num(1, u64::MAX));
+            let t = lock(&st.trace);
+            let mut out = String::from("# call\trva\thash\tscript\targc\targs (first four)\tfirst return slot\n");
+            let mut n = 0;
+            for e in t.log.iter().filter(|e| e.0 >= from && e.0 <= to).take(400_000) {
+                let argc = (e.3 as usize).min(4);
+                out.push_str(&format!(
+                    "{}\t+{:#x}\t{:#018x}\t{:#x}\t{}\t({})\t{}\n",
+                    e.0,
+                    e.1,
+                    st.by_rva.get(&(e.1 as usize)).copied().unwrap_or(0),
+                    e.2,
+                    e.3,
+                    e.4[..argc].iter().map(|a| fmt_slot(*a)).collect::<Vec<_>>().join(" "),
+                    fmt_slot(e.5)
+                ));
+                n += 1;
+            }
+            let path = folder.join("natives-log.tsv");
+            Reply::Now(std::fs::write(&path, out).map(|()| format!("{n} of {} logged calls ({from}..{to}) -> {}", t.log.len(), path.display())).map_err(|e| e.to_string()))
+        }
+        "nwatchmem" => Reply::Now(match args.first() {
+            Some(spec) => set_memwatch(spec),
+            None => Err("nwatchmem +0x<rva>:<len>[,...] | off".into()),
+        }),
+        "nstat" => {
+            let q = lock(&st.queue);
+            let t = lock(&st.trace);
+            let mut scripts: Vec<_> = t.scripts.iter().collect();
+            scripts.sort_by(|a, b| b.1.cmp(a.1));
+            Reply::Now(Ok(format!(
+                "natives hook on: {} handlers, {} names, base {:#x}, trace {}, {} native calls seen, {} distinct, queued {}, only script {:#x}, vars {:?}\nthreads (id:calls): {}\nscripts by calls: {}",
+                st.by_rva.len(),
+                st.names.len(),
+                st.base,
+                TRACING.load(Ordering::Relaxed),
+                SEQ.load(Ordering::Relaxed),
+                t.stats.len(),
+                q.calls.len(),
+                q.only_script,
+                q.vars.iter().map(|(k, v)| format!("{k}={v:x?}")).collect::<Vec<_>>(),
+                t.threads.iter().map(|(k, v)| format!("{k:#x}:{v}")).collect::<Vec<_>>().join(" "),
+                scripts.iter().take(40).map(|(s, n)| format!("{s:#x}:{n}")).collect::<Vec<_>>().join(" ")
+            )))
+        }
+        "ntrace" => {
+            let on = args.first() == Some(&"on");
+            TRACING.store(on, Ordering::Relaxed);
+            Reply::Now(Ok(format!("trace {}", if on { "on" } else { "off" })))
+        }
+        "nmark" => {
+            mark(&args.join(" "));
+            Reply::Now(Ok(format!("mark at call {}", SEQ.load(Ordering::Relaxed))))
+        }
+        "nwatch" => {
+            let mut t = lock(&st.trace);
+            if args.first() == Some(&"off") {
+                t.watch.clear();
+                return Reply::Now(Ok("no native watched".into()));
+            }
+            for w in args {
+                match target(st, w) {
+                    Ok(r) => t.watch.push(r),
+                    Err(e) => return Reply::Now(Err(e)),
+                }
+            }
+            Reply::Now(Ok(format!("watching {:x?} (needs the trace on)", t.watch)))
+        }
+        "nscript" => {
+            let id = match args.first() {
+                Some(&"any") | None => 0,
+                Some(w) => match u32::from_str_radix(w.trim_start_matches("0x"), 16) {
+                    Ok(v) => v,
+                    Err(_) => return Reply::Now(Err(format!("bad script id {w}"))),
+                },
+            };
+            lock(&st.queue).only_script = id;
+            Reply::Now(Ok(format!("queued calls run in script {id:#x} (0 = any)")))
+        }
+        "nfind" => Reply::Now(args.first().ok_or_else(|| "nfind <native>".to_string()).and_then(|w| target(st, w)).map(|rva| {
+            let t = lock(&st.trace);
+            let seen = t.stats.get(&rva).map_or("not called yet (or no trace)".to_string(), |s| format!("{} calls, argc {}, retc {}", s.count, s.argc, s.retc));
+            format!("+{rva:#x} hash {:#018x}: {seen}", st.by_rva[&rva])
+        })),
+        _ => Reply::Now(dump(st, folder)),
+    }
+}
+
+/// Queues one call: `<native> [ret=<n>] [><var>] [<arg>...]`.
+fn queue_call(st: &State, args: &[&str]) -> Result<(u64, String), String> {
+    let name = args.first().ok_or("ncall <native> [ret=<n>] [><var>] [<arg>...]")?;
+    let rva = target(st, name)?;
+    let (mut nret, mut store, mut parsed) = (1usize, None, Vec::new());
+    for w in &args[1..] {
+        if let Some(n) = w.strip_prefix("ret=") {
+            nret = n.parse::<usize>().ok().filter(|n| *n <= 16).ok_or_else(|| format!("bad {w}"))?;
+        } else if let Some(v) = w.strip_prefix('>') {
+            store = Some(v.to_string());
+        } else {
+            parsed.extend(parse_args(w)?);
+        }
+    }
+    let mut q = lock(&st.queue);
+    let id = q.next_id;
+    q.next_id += 1;
+    let text = format!("{name} (+{rva:#x}, hash {:#018x}) {}", st.by_rva[&rva], args[1..].join(" "));
+    q.calls.push_back(Call { id, rva, args: parsed, nret, store, text: text.clone() });
+    QUEUED.store(q.calls.len(), Ordering::Relaxed);
+    Ok((id, format!("queued #{id}: {text}")))
+}
+
+/// A mark in the trace (the debug channel marks world frames).
+pub fn mark(label: &str) {
+    if let Some(st) = STATE.get() {
+        if TRACING.load(Ordering::Relaxed) {
+            lock(&st.trace).marks.push((SEQ.load(Ordering::Relaxed), label.to_string()));
+        }
+    }
+}
+
+/// The finished result of queued call `id`, once.
+pub fn result(id: u64) -> Option<String> {
+    lock(&STATE.get()?.queue).done.remove(&id)
+}
+
+fn fmt_sample(s: &Sample) -> String {
+    let args = s
+        .args
+        .iter()
+        .enumerate()
+        .map(|(i, a)| match s.strs.iter().find(|(j, _)| *j == i) {
+            Some((_, text)) => format!("\"{text}\""),
+            None => fmt_slot(*a),
+        })
+        .collect::<Vec<_>>()
+        .join(" ");
+    let ret = if s.ret.is_empty() { String::new() } else { format!(" -> {}", s.ret.iter().map(|r| fmt_slot(*r)).collect::<Vec<_>>().join(" ")) };
+    format!("#{} t={}ms script={:#x} ({}){}", s.seq, s.ms, s.script, args, ret)
+}
+
+/// Writes `natives-trace.tsv` (one line per native seen, in order of first
+/// call, with the marks between them) and `natives-watch.tsv`.
+fn dump(st: &State, folder: &std::path::Path) -> Result<String, String> {
+    let t = lock(&st.trace);
+    let mut rows: Vec<(&usize, &Stat)> = t.stats.iter().collect();
+    rows.sort_by_key(|(_, s)| s.first_seq);
+    let mut out = String::from("# rva\thash\tcalls\targc\tretc\tfirst call\tsamples (call number, ms since start, script, args, return)\n");
+    let mut marks = t.marks.iter().peekable();
+    for (rva, s) in &rows {
+        while let Some((seq, label)) = marks.next_if(|(seq, _)| *seq < s.first_seq) {
+            out.push_str(&format!("# mark {label} at call {seq}\n"));
+        }
+        let hash = st.by_rva.get(*rva).copied().unwrap_or(0);
+        let samples = s.samples.iter().map(fmt_sample).collect::<Vec<_>>().join(" | ");
+        out.push_str(&format!("+{rva:#x}\t{hash:#018x}\t{}\t{}\t{}\t{}\t{samples}\n", s.count, s.argc, s.retc, s.first_seq));
+    }
+    for (seq, label) in marks {
+        out.push_str(&format!("# mark {label} at call {seq}\n"));
+    }
+    let path = folder.join("natives-trace.tsv");
+    std::fs::write(&path, out).map_err(|e| format!("{}: {e}", path.display()))?;
+    let mut w = String::from("# rva\thash\tcall\n");
+    for (rva, s) in &t.watched {
+        w.push_str(&format!("+{rva:#x}\t{:#018x}\t{}\n", st.by_rva.get(rva).copied().unwrap_or(0), fmt_sample(s)));
+    }
+    let _ = std::fs::write(folder.join("natives-watch.tsv"), w);
+    if !t.mem_events.is_empty() {
+        let head = "# call number\tms\tscript\twhere (in +rva = during that native; between natives = elsewhere)\thash\targs\tchanged dwords (+rva: old->new)\n";
+        let _ = std::fs::write(folder.join("natives-memwatch.tsv"), format!("{head}{}\n", t.mem_events.join("\n")));
+    }
+    Ok(format!("{} natives seen in {} calls -> {} ({} watched calls -> natives-watch.tsv)", rows.len(), SEQ.load(Ordering::Relaxed), path.display(), t.watched.len()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_handler_is_known_by_its_shape() {
+        // push rsi ; push rdi ; sub rsp, 28h ; cmp dword [rcx+10h], 0 ; mov rsi, rcx ; js ; ... ;
+        // mov rax, [rsi] ; movabs rcx, hash ; mov [rax], rcx ; jmp
+        let mut code = vec![0x56, 0x57, 0x48, 0x83, 0xec, 0x28, 0x83, 0x79, 0x10, 0x00, 0x48, 0x89, 0xce, 0x78, 0x20];
+        code.extend([0x90; 0x20]);
+        code.extend([0x48, 0x8b, 0x06, 0x48, 0xb9]);
+        code.extend(0xdd3c_edb4_d045_7eddu64.to_le_bytes());
+        code.extend([0x48, 0x89, 0x08, 0xeb, 0xcd]);
+        assert_eq!(handler_hash(&code), Some(0xdd3c_edb4_d045_7edd));
+        // Without the argument-count test it is not a handler.
+        code[6] = 0x90;
+        assert_eq!(handler_hash(&code), None);
+        assert_eq!(handler_hash(&[0xc3]), None);
+    }
+
+    #[test]
+    fn the_stub_and_the_site() {
+        let stub = stub_code(0x1122_3344_5566_7788);
+        // lea rcx, [rsp+0B0h]: the title's [rsp+0A8h] past the return address our call pushed.
+        assert_eq!(stub[..8], [0x48, 0x8d, 0x8c, 0x24, 0xb0, 0, 0, 0]);
+        assert_eq!(stub[stub.len() - 8..], 0x1122_3344_5566_7788u64.to_le_bytes());
+        assert_eq!(stub.len(), 31);
+        let site = site_code(0x1_43de_7503, 0x1_4b10_0000).unwrap();
+        assert_eq!(site.len(), SITE_BYTES.len());
+        assert_eq!(site[0], 0xe8);
+        let rel = i32::from_le_bytes(site[1..5].try_into().unwrap());
+        assert_eq!(0x1_43de_7503i64 + 5 + i64::from(rel), 0x1_4b10_0000);
+        assert!(site_code(0x1_43de_7503, 0x7_0000_0000).is_none());
+    }
+
+    #[test]
+    fn arguments() {
+        assert_eq!(parse_arg("12"), Ok(Arg::Val(12)));
+        assert_eq!(parse_arg("-1"), Ok(Arg::Val(0xffff_ffff)));
+        assert_eq!(parse_arg("0x1f"), Ok(Arg::Val(0x1f)));
+        assert_eq!(parse_arg("1.5"), Ok(Arg::Val(u64::from(1.5f32.to_bits()))));
+        assert_eq!(parse_arg("$ped"), Ok(Arg::Var("ped".into(), None)));
+        assert_eq!(parse_arg("$ped.1"), Ok(Arg::Var("ped".into(), Some(1))));
+        // x = 1.0 low, y = 2.0 high, then z.
+        assert_eq!(parse_args("v:1,2,-3.5"), Ok(vec![Arg::Val(0x4000_0000_3f80_0000), Arg::Val(0xc060_0000)]));
+        assert!(parse_args("v:1,2").is_err());
+        assert_eq!(parse_ranges("+0x100:0x20,0x200:16", 0x1000, 0x1000), Ok(vec![(0x1100, 0x20), (0x1200, 16)]));
+        assert!(parse_ranges("+0xff0:0x20", 0x1000, 0x1000).is_err());
+        assert_eq!(parse_arg("h:adder"), Ok(Arg::Val(0xb779_a091)));
+        assert!(parse_arg("x").is_err());
+        let Ok(Arg::Val(p)) = parse_arg("s:hello~you") else { panic!() };
+        // SAFETY: the leaked, NUL-terminated text.
+        let text = unsafe { std::ffi::CStr::from_ptr(p as *const _) };
+        assert_eq!(text.to_str(), Ok("hello you"));
+        assert_eq!(fmt_slot(u64::from(2.5f32.to_bits())), "0x40200000(2.5)");
+        assert_eq!(fmt_slot(7), "0x7");
+    }
+}
