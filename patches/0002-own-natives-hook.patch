+#[cfg(windows)]
+fn read_names() -> HashMap<String, u64> {
+    let mut names = HashMap::new();
+    let Some(path) = std::env::var_os(NAMES_ENV) else { return names };
+    let Ok(text) = std::fs::read_to_string(&path) else {
+        tracing::warn!(path = %std::path::Path::new(&path).display(), "{NAMES_ENV}: the file could not be read");
+        return names;
+    };
+    for line in text.lines() {
+        let mut w = line.split_whitespace();
+        if let (Some(name), Some(hash)) = (w.next(), w.next()) {
+            if let Some(h) = hash.strip_prefix("0x").and_then(|h| u64::from_str_radix(h, 16).ok()) {
+                names.insert(name.to_ascii_uppercase(), h);
+            }
+        }
+    }
+    names
+}
+
+/// Memory of ours for `len` bytes within 2 GiB of the image (above its
+/// end, else below its start), zeroed; its address, or `None` (for the stubs).
+#[cfg(windows)]
+fn near_image(base: usize, size: usize, len: usize) -> Option<usize> {
+    use windows_sys::Win32::System::Memory::{MEM_COMMIT, MEM_RESERVE, PAGE_READWRITE, VirtualAlloc};
+    const STEP: usize = 0x1_0000;
+    let above = (base + size).next_multiple_of(STEP);
+    let below = base.checked_sub(len.next_multiple_of(STEP))? & !(STEP - 1);
+    let tries = (0..1024).map(|k| above + k * STEP).chain((0..1024).filter_map(|k| below.checked_sub(k * STEP)));
+    for at in tries {
+        // SAFETY: a fresh allocation at an address we only ask for.
+        let got = unsafe { VirtualAlloc(at as *const _, len, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE) } as usize;
+        if got != 0 {
+            return Some(got);
+        }
+    }
+    None
+}
+
+/// A NUL-terminated printable string at `p`, if `p` points at readable memory.
+#[cfg(windows)]
+fn string_at(p: u64) -> Option<String> {
+    use windows_sys::Win32::System::Memory::{MEM_COMMIT, MEMORY_BASIC_INFORMATION, PAGE_GUARD, PAGE_NOACCESS, VirtualQuery};
+    let p = p as usize;
+    if !(0x1_0000..0x7fff_ffff_0000).contains(&p) {
+        return None;
+    }
+    // SAFETY: VirtualQuery only reports on the address.
+    let mut info: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+    if unsafe { VirtualQuery(p as _, &mut info, size_of::<MEMORY_BASIC_INFORMATION>()) } == 0 {
+        return None;
+    }
+    if info.State != MEM_COMMIT || info.Protect & (PAGE_GUARD | PAGE_NOACCESS) != 0 || info.Protect == 0 {
+        return None;
+    }
+    let end = info.BaseAddress as usize + info.RegionSize;
+    let len = (end - p).min(80);
+    // SAFETY: committed, readable memory up to the region's end.
+    let bytes = unsafe { std::slice::from_raw_parts(p as *const u8, len) };
+    let n = bytes.iter().position(|&b| b == 0)?;
+    if n < 3 || !bytes[..n].iter().all(|&b| (0x20..0x7f).contains(&b)) {
+        return None;
+    }
+    Some(String::from_utf8_lossy(&bytes[..n]).into_owned())
+}
+
+/// The running script's program id (`[[sctx+48h]+8]+10h`), 0 if unknown.
+unsafe fn script_id(sctx: usize) -> u32 {
+    if sctx < 0x1_0000 {
+        return 0;
+    }
+    // SAFETY: the interpreter's own context; the same reads it does.
+    unsafe {
+        let frame = ((sctx + 0x48) as *const usize).read_unaligned();
+        if frame < 0x1_0000 {
+            return 0;
+        }
+        let prog = ((frame + 8) as *const usize).read_unaligned();
+        if prog < 0x1_0000 {
+            return 0;
+        }
+        ((prog + 0x10) as *const u32).read_unaligned()
+    }
+}
+
+/// Called by the stub in place of the NATIVE opcode's `call r15`.
+///
+/// # Safety
+/// Called only by the stub, on a title thread inside the interpreter.
+#[cfg(windows)]
+unsafe extern "win64" fn dispatch(ctx: *mut Ctx, handler: usize, sctx: usize) {
+    let Some(st) = STATE.get() else {
+        // SAFETY: the call the title asked for.
+        unsafe { std::mem::transmute::<usize, unsafe extern "win64" fn(*mut Ctx)>(handler)(ctx) };
+        return;
+    };
+    if QUEUED.load(Ordering::Relaxed) != 0 && !IN_QUEUE.swap(true, Ordering::Acquire) {
+        // SAFETY: on a script thread, between two of the script's natives.
+        unsafe { run_queue(st, sctx) };
+        IN_QUEUE.store(false, Ordering::Release);
+    }
+    let memwatch = MEMWATCH.load(Ordering::Relaxed);
+    if memwatch {
+        // SAFETY: the context the interpreter just built.
+        unsafe { mem_check(st, None, sctx) };
+    }
+    let mut sampled = None;
+    if TRACING.load(Ordering::Relaxed) {
+        // SAFETY: the context the interpreter just built.
+        sampled = unsafe { before(st, &*ctx, handler, sctx) };
+    }
+    // SAFETY: the call the title asked for.
+    unsafe { std::mem::transmute::<usize, unsafe extern "win64" fn(*mut Ctx)>(handler)(ctx) };
+    if memwatch {
+        // SAFETY: as above.
+        unsafe { mem_check(st, Some((&*ctx, handler)), sctx) };
+    }
+    if let Some((seq, watched)) = sampled {
+        // SAFETY: as above; the return pointer is the interpreter's stack.
+        let ret = unsafe {
+            if (*ctx).ret.is_null() { Vec::new() } else { std::slice::from_raw_parts((*ctx).ret, ((*ctx).retc as usize).min(4)).to_vec() }
+        };
+        let rva = handler - st.base;
+        let mut t = lock(&st.trace);
+        if LOGGING.load(Ordering::Relaxed) {
+            // The entry is near the end (other threads may have added a few since).
+            if let Some(e) = t.log.iter_mut().rev().take(64).find(|e| e.0 == seq) {
+                e.5 = ret.first().copied().unwrap_or(0);
+            }
+        }
+        if watched {
+            if let Some(s) = t.watched.iter_mut().rev().find(|(r, s)| *r == rva && s.seq == seq) {
+                s.1.ret = ret.clone();
+            }
+        }
+        if let Some(s) = t.stats.get_mut(&rva).and_then(|s| s.samples.iter_mut().find(|s| s.seq == seq)) {
+            s.ret = ret;
+        }
+    }
+}
+
+/// Compares the watched memory with what was last seen and notes what changed: `by` is the native that just
+/// returned (the change happened inside it), `None` = before a native (the change came from elsewhere, since
+/// the previous native call on any thread).
+#[cfg(windows)]
+unsafe fn mem_check(st: &State, by: Option<(&Ctx, usize)>, sctx: usize) {
+    let mut t = lock(&st.trace);
+    let t = &mut *t;
+    for (addr, last) in &mut t.mem {
+        // SAFETY: a range inside the mapped image's data (checked when the watch was set).
+        let now = unsafe { std::slice::from_raw_parts(*addr as *const u8, last.len()) };
+        if now == &last[..] {
+            continue;
+        }
+        let first = last.chunks(4).zip(now.chunks(4)).position(|(a, b)| a != b).unwrap_or(0);
+        let seen = t.mem_seen.entry(*addr + first * 4).or_default();
+        *seen += 1;
+        if t.mem_events.len() < MEM_EVENTS_MAX && *seen <= 16 {
+            let mut diffs = Vec::new();
+            for (i, (a, b)) in last.chunks(4).zip(now.chunks(4)).enumerate() {
+                if a != b && diffs.len() < 10 {
+                    let v = |c: &[u8]| c.iter().rev().map(|x| format!("{x:02x}")).collect::<String>();
+                    diffs.push(format!("+{:#x}: {}->{}", *addr - st.base + i * 4, v(a), v(b)));
+                }
+            }
+            let who = match by {
+                Some((ctx, handler)) => {
+                    let n = (ctx.argc as usize).min(8);
+                    // SAFETY: `argc` slots on the script's stack.
+                    let args: Vec<String> =
+                        if ctx.args.is_null() { Vec::new() } else { unsafe { std::slice::from_raw_parts(ctx.args, n) }.iter().map(|a| fmt_slot(*a)).collect() };
+                    let rva = handler.wrapping_sub(st.base);
+                    format!("in +{rva:#x}\t{:#018x}\t({})", st.by_rva.get(&rva).copied().unwrap_or(0), args.join(" "))
+                }
+                None => "between natives\t\t".to_string(),
+            };
+            // SAFETY: the interpreter's context.
+            let script = unsafe { script_id(sctx) };
+            t.mem_events.push(format!(
+                "{}\t{}ms\tscript {script:#x}\t{who}\t{}",
+                SEQ.load(Ordering::Relaxed),
+                st.started.elapsed().as_millis(),
+                diffs.join(" ")
+            ));
+        }
+        last.copy_from_slice(now);
+    }
+}
