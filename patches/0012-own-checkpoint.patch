+/// LOCAL (octo, inkVI-dive): one call of `MISSION_STAGE_SET`: the title announced a mission stage (`restart` 1 =
+/// the retry after a fail restarts the mission at that stage).
+#[derive(Clone, Debug, PartialEq)]
+pub struct StageEvent {
+    /// Counts the calls from 1.
+    pub seq: u64,
+    pub stage: u32,
+    pub restart: u32,
+    pub script: u32,
+    pub at: Instant,
+}
+
+/// The newest stage announcements (`STAGES_MAX`) and every stage hash announced this session.
+static STAGES: Mutex<(Vec<StageEvent>, Vec<u32>, u64)> = Mutex::new((Vec::new(), Vec::new(), 0));
+const STAGES_MAX: usize = 512;
+
+#[cfg(windows)]
+fn note_stage(st: &State, stage: u32, restart: u32, script: u32) {
+    let mut s = lock(&STAGES);
+    s.2 += 1;
+    let seq = s.2;
+    // The title announces each stage twice in a row: only a change is logged.
+    let new = s.0.last().is_none_or(|e| e.stage != stage || e.restart != restart);
+    if s.0.len() >= STAGES_MAX {
+        s.0.remove(0);
+    }
+    s.0.push(StageEvent { seq, stage, restart, script, at: Instant::now() });
+    if !s.1.contains(&stage) && s.1.len() < 4096 {
+        s.1.push(stage);
+    }
+    drop(s);
+    if new {
+        tracing::info!(stage = format_args!("{stage:#010x}"), restart, script = format_args!("{script:#x}"),
+            ms = st.started.elapsed().as_millis() as u64, "{ENV}: mission stage announced");
+    }
+}
+
+/// The stage announcements after call `seq` (0 = all kept), oldest first.
+pub fn stage_events_after(seq: u64) -> Vec<StageEvent> {
+    lock(&STAGES).0.iter().filter(|e| e.seq > seq).cloned().collect()
+}
+
+/// Every stage hash the title announced this session, in order of first announcement.
+pub fn stages_seen() -> Vec<u32> {
+    lock(&STAGES).1.clone()
+}
+
+/// Whether stage announcements are seen (the hook is on and `MISSION_STAGE_SET` is named).
+pub fn stage_hooked() -> bool {
+    STATE.get().is_some_and(|st| st.stage_rva != 0)
+}
