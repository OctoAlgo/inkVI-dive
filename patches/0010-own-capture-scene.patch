diff --git a/crates/victory-gpu/src/capture.rs b/crates/victory-gpu/src/capture.rs
index da63efd74..5b173a8ff 100644
--- a/crates/victory-gpu/src/capture.rs
+++ b/crates/victory-gpu/src/capture.rs
@@ -181,7 +181,55 @@ pub(crate) fn wanted(n: u64) -> bool {
     // run, so single frames cannot be compared between runs).
     let first = WORLD.load(std::sync::atomic::Ordering::Relaxed);
     let in_world = world_on() && first != u64::MAX && n > first && (n - first).is_multiple_of(world_every());
-    folder().is_some() && (n.is_power_of_two() || listed(n) || before_world || in_world || in_secs(n))
+    folder().is_some() && (n.is_power_of_two() || listed(n) || before_world || in_world || in_secs(n) || asked(n) || in_scene(n))
+}
+
+/// LOCAL (octo, inkVI-dive): frames the debug channel's `cap [<n>]` asked for: `(first << 32) | last` (presents).
+static ASKED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// LOCAL (octo, inkVI-dive): saves the `count` frames after present `now` (the debug channel's `cap`).
+pub(crate) fn ask(now: u64, count: u64) -> bool {
+    if folder().is_none() {
+        return false;
+    }
+    let (a, b) = ((now + 1) & 0xffff_ffff, (now + count.max(1)) & 0xffff_ffff);
+    ASKED.store((a << 32) | b, std::sync::atomic::Ordering::Relaxed);
+    true
+}
+
+fn asked(n: u64) -> bool {
+    let v = ASKED.load(std::sync::atomic::Ordering::Relaxed);
+    v != 0 && n >= v >> 32 && n <= (v & 0xffff_ffff)
+}
+
+/// LOCAL (octo, inkVI-dive): `VICTORY_CAPTURE_SCENE=0x<name>:<a>-<b>`: every frame presented between `a` and `b`
+/// seconds of wall time after ANY start of the scene (cutscene) of that name hash, by a script or by the debug
+/// channel's `scene play` (needs `VICTORY_NATIVES` and the names file). Each new start opens the window again, so
+/// a cutscene and its replays are all saved. Decided once per frame, like `VICTORY_CAPTURE_SECS`.
+fn in_scene(n: u64) -> bool {
+    use std::sync::atomic::Ordering::Relaxed;
+    static WINDOW: std::sync::OnceLock<Option<(u32, f64, f64)>> = std::sync::OnceLock::new();
+    let Some((name, a, b)) = *WINDOW.get_or_init(|| {
+        let v = std::env::var("VICTORY_CAPTURE_SCENE").ok()?;
+        let (name, secs) = v.split_once(':')?;
+        let name = u32::from_str_radix(name.trim().trim_start_matches("0x"), 16).ok()?;
+        let (a, b) = secs.split_once('-')?;
+        Some((name, a.trim().parse().ok()?, b.trim().parse().ok()?))
+    }) else {
+        return false;
+    };
+    static LAST: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(u64::MAX);
+    let last = LAST.load(Relaxed);
+    if last != u64::MAX && last >> 1 == n {
+        return last & 1 == 1;
+    }
+    let t = victory_loader::natives::since_scene_start(name);
+    let yes = t.is_some_and(|t| t >= a && t <= b);
+    LAST.store((n << 1) | u64::from(yes), Relaxed);
+    if yes {
+        tracing::info!(frame = n, secs = t, scene = format_args!("{name:#010x}"), "VICTORY_CAPTURE_SCENE: frame in the window");
+    }
+    yes
 }
 
