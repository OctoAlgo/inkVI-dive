+#[cfg(windows)]
+mod live {
+    use super::*;
+    use windows_sys::Win32::System::LibraryLoader::GetModuleHandleW;
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEM_IMAGE, MEMORY_BASIC_INFORMATION, PAGE_EXECUTE_READWRITE, PAGE_EXECUTE_WRITECOPY, PAGE_GUARD,
+        PAGE_NOACCESS, PAGE_READWRITE, PAGE_WRITECOPY, VirtualQuery,
+    };
+
+    pub(super) struct Process;
+
+    fn query(at: usize) -> Option<MEMORY_BASIC_INFORMATION> {
+        // SAFETY: plain data filled in by the query.
+        let mut m: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+        // SAFETY: a valid out pointer of the right size.
+        (unsafe { VirtualQuery(at as *const _, &mut m, size_of_val(&m)) } != 0).then_some(m)
+    }
+
+    fn writable(p: u32) -> bool {
+        matches!(p & 0xff, PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)
+    }
+
+    /// Whether every page of [addr, addr+len) is committed and readable
+    /// (and writable, if asked).
+    fn accessible(addr: usize, len: usize, write: bool) -> bool {
+        let Some(end) = addr.checked_add(len) else { return false };
+        let mut at = addr;
+        while at < end {
+            let Some(m) = query(at) else { return false };
+            if m.State != MEM_COMMIT || m.Protect & PAGE_GUARD != 0 || m.Protect & 0xff == PAGE_NOACCESS {
+                return false;
+            }
+            if write && !writable(m.Protect) {
+                return false;
+            }
+            at = (m.BaseAddress as usize).saturating_add(m.RegionSize);
+        }
+        true
+    }
+
+    impl Memory for Process {
+        fn image_base(&self) -> usize {
+            static BASE: OnceLock<usize> = OnceLock::new();
+            *BASE.get_or_init(|| {
+                let name = std::env::var("VICTORY_DEBUG_IMAGE").unwrap_or_else(|_| "game_scarlett_master.exe".into());
+                let wide: Vec<u16> = name.encode_utf16().chain(Some(0)).collect();
+                // SAFETY: a NUL-terminated name; the handle is only read as a number.
+                let h = unsafe { GetModuleHandleW(wide.as_ptr()) };
+                let base = h as usize;
+                if base == 0 {
+                    tracing::warn!(name, "VICTORY_DEBUG: the title's module was not found; `img+` addresses are unavailable");
+                }
+                base
+            })
+        }
+
+        fn read(&self, addr: usize, len: usize) -> Option<Vec<u8>> {
+            if len == 0 || !accessible(addr, len, false) {
+                return None;
+            }
+            // SAFETY: every page is committed and readable (checked just now; a
+            // concurrent decommit is the diagnostics build's risk).
+            Some(unsafe { std::slice::from_raw_parts(addr as *const u8, len) }.to_vec())
+        }
+
+        fn write(&self, addr: usize, bytes: &[u8]) -> bool {
+            if bytes.is_empty() || !accessible(addr, bytes.len(), true) {
+                return false;
+            }
+            // SAFETY: committed and writable (checked just now).
+            unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), addr as *mut u8, bytes.len()) };
+            true
+        }
+
+        fn regions(&self) -> Vec<Region> {
+            let mut out = Vec::new();
+            let mut at = 0usize;
+            while let Some(m) = query(at) {
+                let next = (m.BaseAddress as usize).saturating_add(m.RegionSize);
+                if m.State == MEM_COMMIT && m.Protect & PAGE_GUARD == 0 && writable(m.Protect) {
+                    out.push(Region { base: m.BaseAddress as usize, size: m.RegionSize, image: m.Type == MEM_IMAGE });
+                }
+                if next <= at {
+                    break;
+                }
+                at = next;
+            }
+            out
+        }
+    }
+}
