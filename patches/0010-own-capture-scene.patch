+/// LOCAL (octo, inkVI-dive): the last start of each scene name (`VICTORY_CAPTURE_SCENE` keys captures on it).
+static STARTS: Mutex<Vec<(u32, Instant)>> = Mutex::new(Vec::new());
+
+/// A scene object was started (SCENE_START by a script or by the channel): notes when, under its name.
+#[cfg(windows)]
+fn note_start(st: &State, obj: u64, script: u32) {
+    let Some(name) = lock(&st.scenes).iter().rev().find(|s| s.obj == obj).map(|s| s.name) else { return };
+    let mut starts = lock(&STARTS);
+    starts.retain(|(n, _)| *n != name);
+    starts.push((name, Instant::now()));
+    tracing::info!(name = format_args!("{name:#010x}"), obj = format_args!("{obj:#x}"), script = format_args!("{script:#x}"),
+        ms = st.started.elapsed().as_millis() as u64, "{ENV}: scene started");
+}
+
+/// Seconds since the scene named `name` was last started, if it was.
+pub fn since_scene_start(name: u32) -> Option<f64> {
+    lock(&STARTS).iter().find(|(n, _)| *n == name).map(|(_, at)| at.elapsed().as_secs_f64())
+}
