+/// Where `pattern` occurs in `hay`: `Ok(offset)` if exactly once, else `Err(count)` (0, or 2 = more than once).
+pub fn find_unique(hay: &[u8], pattern: &[Option<u8>]) -> Result<usize, usize> {
+    let Some(Some(first)) = pattern.first().copied() else { return Err(0) };
+    let mut found = None;
+    let mut at = 0;
+    while at + pattern.len() <= hay.len() {
+        let Some(i) = hay[at..=hay.len() - pattern.len()].iter().position(|&b| b == first) else { break };
+        let p = at + i;
+        if pattern.iter().zip(&hay[p..]).all(|(want, &b)| want.is_none_or(|w| w == b)) {
+            if found.is_some() {
+                return Err(2);
+            }
+            found = Some(p);
+        }
+        at = p + 1;
+    }
+    found.ok_or(0)
+}
