+//! LOCAL (octo, inkVI-dive): the title's script natives, for
+//! the diagnostics build's debug channel.
+//!
+//! GTA VI 1.0.2.1 (how it was found: the inkVI-dive README):
+//!  * a script native is a function `handler(ctx)` with
+//!    `ctx = { args: *mut u64, ret: *mut u64, argc: u32, retc: u32 }`; every
+//!    handler starts with `cmp dword [rcx+10h], 0` and holds its own 64-bit
+//!    hash (`movabs r, hash ; mov [args], r` on the `argc < 0` path). There
+//!    is no table in the image: [`scan`] finds the 6820 handlers by that
+//!    shape through the image's function table;
+//!  * the script interpreter (+0x3de2550) calls a native in its NATIVE
+//!    opcode: `lea rcx, [rsp+0A8h] ; vzeroupper ; call r15` at +0x3de7503.
+//!
+//! `VICTORY_NATIVES=1` replaces those 14 bytes (checked) with a call to a
+//! small stub of ours, which hands the context, the handler and the running
+//! script's context to [`dispatch`]. `dispatch` first runs the calls the
+//! debug channel queued (`ncall`), so they happen on a script thread inside
+//! a script's update, exactly where the title calls natives itself, then
+//! the native the script asked for. `VICTORY_NATIVES=trace` also records,
+//! per native, how often it is called and its first calls' arguments.
+
+use std::collections::{HashMap, VecDeque};
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Mutex, MutexGuard, OnceLock};
+use std::time::Instant;
+
+/// Environment variable: `1` = hook + call queue, `trace` = also the trace.
+pub const ENV: &str = "VICTORY_NATIVES";
+/// Optional file of names: lines `NAME 0x<hash>` (`#` comments).
+pub const NAMES_ENV: &str = "VICTORY_NATIVES_NAMES";
+/// Optional memory watch from the start: `+0x<rva>:<len>[,...]` (see `nwatchmem`).
+pub const WATCHMEM_ENV: &str = "VICTORY_NATIVES_WATCHMEM";
+
+/// First 16 hex digits of the BLAKE3 of the Series X 1.0.2.1 executable.
+const BUILD_1_0_2_1: &str = "b99f876b74d4a77f";
+/// The NATIVE opcode's call: `lea rcx, [rsp+0A8h] ; vzeroupper ; call r15`.
+const SITE: usize = 0x3de_7503;
+const SITE_BYTES: [u8; 14] = [0x48, 0x8d, 0x8c, 0x24, 0xa8, 0, 0, 0, 0xc5, 0xf8, 0x77, 0x41, 0xff, 0xd7];
+/// How many handlers this build has (a different count is only warned about).
+const HANDLERS_1_0_2_1: usize = 6820;
+/// Samples (first calls with their arguments) kept per native.
+const SAMPLES: usize = 3;
+/// Calls of a watched native that are kept.
+const WATCH_MAX: usize = 400;
+
+/// The title's native call context.
+#[repr(C)]
+pub struct Ctx {
+    args: *mut u64,
+    ret: *mut u64,
+    argc: u32,
+    retc: u32,
+}
+
+/// One argument of a queued call.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Arg {
+    Val(u64),
+    /// The slots a previous call stored under a name (`$name`), or one of them (`$name.1`).
+    Var(String, Option<usize>),
+}
+
+struct Call {
+    id: u64,
+    rva: usize,
+    args: Vec<Arg>,
+    nret: usize,
+    store: Option<String>,
+    text: String,
+}
+
+#[derive(Clone, Default)]
+struct Sample {
+    seq: u64,
+    ms: u64,
+    script: u32,
+    args: Vec<u64>,
+    strs: Vec<(usize, String)>,
+    ret: Vec<u64>,
+}
+
+#[derive(Default)]
+struct Stat {
+    count: u64,
+    argc: u32,
+    retc: u32,
+    first_seq: u64,
+    samples: Vec<Sample>,
+}
+
+#[derive(Default)]
+struct Trace {
+    stats: HashMap<usize, Stat>,
+    scripts: HashMap<u32, u64>,
+    marks: Vec<(u64, String)>,
+    watch: Vec<usize>,
+    watched: Vec<(usize, Sample)>,
+    /// Native calls per thread id.
+    threads: HashMap<u32, u64>,
+    /// Watched memory (`nwatchmem`): address, the bytes last seen.
+    mem: Vec<(usize, Vec<u8>)>,
+    mem_events: Vec<String>,
+    /// Events noted per first changed offset (a counter that changes every frame is noted only a few times).
+    mem_seen: HashMap<usize, u32>,
+    /// Every call (`VICTORY_NATIVES=log`): call number, rva, script, argc, the first four args, the first return slot.
+    log: Vec<(u64, u32, u32, u32, [u64; 4], u64)>,
+}
+
+#[derive(Default)]
+struct Queue {
+    calls: VecDeque<Call>,
+    done: HashMap<u64, String>,
+    vars: HashMap<String, Vec<u64>>,
+    /// Only this script (program id) runs queued calls; 0 = any.
+    only_script: u32,
+    next_id: u64,
+}
+
+struct State {
+    base: usize,
+    size: usize,
+    by_hash: HashMap<u64, usize>,
+    by_rva: HashMap<usize, u64>,
+    names: HashMap<String, u64>,
+    started: Instant,
+    queue: Mutex<Queue>,
+    trace: Mutex<Trace>,
+}
+
+static STATE: OnceLock<State> = OnceLock::new();
+/// The mapped title executable's base (for the debug channel's `img+` addresses), whether or not the hook is on.
+static TITLE_BASE: AtomicUsize = AtomicUsize::new(0);
+
+/// Where the title's executable is mapped (0 before that).
+pub fn title_base() -> usize {
+    TITLE_BASE.load(Ordering::Relaxed)
+}
+static QUEUED: AtomicUsize = AtomicUsize::new(0);
+static TRACING: AtomicBool = AtomicBool::new(false);
+static SEQ: AtomicU64 = AtomicU64::new(0);
+static IN_QUEUE: AtomicBool = AtomicBool::new(false);
+static MEMWATCH: AtomicBool = AtomicBool::new(false);
+static LOGGING: AtomicBool = AtomicBool::new(false);
+/// Calls the full log keeps (the first ones).
+const LOG_MAX: usize = 3_000_000;
+/// Changes of watched memory that are kept.
+const MEM_EVENTS_MAX: usize = 3000;
+
+fn lock<T>(m: &Mutex<T>) -> MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// The handler in `code` (one function's bytes): its hash, if it has the shape.
+pub fn handler_hash(code: &[u8]) -> Option<u64> {
+    let head = &code[..code.len().min(0x60)];
+    if !head.windows(4).any(|w| w == [0x83, 0x79, 0x10, 0x00]) {
+        return None;
+    }
+    // movabs r64, imm64 ; mov [r64], r64   (the last such pair)
+    let mut found = None;
+    for i in 0..code.len().saturating_sub(12) {
+        let c = &code[i..i + 13];
+        if (c[0] == 0x48 || c[0] == 0x49) && (0xb8..=0xbf).contains(&c[1]) && (c[10] == 0x48 || c[10] == 0x4c) && c[11] == 0x89 && c[12] < 0x40
+        {
+            found = Some(u64::from_le_bytes(c[2..10].try_into().ok()?));
+        }
+    }
+    found
+}
+
+/// Every native handler of the mapped image at `base`: (rva, hash).
+///
+/// # Safety
+/// `base` is a mapped PE image of `size` bytes.
+unsafe fn scan(base: usize, size: usize) -> Vec<(usize, u64)> {
+    // SAFETY: the headers and the function table of a mapped image.
+    unsafe {
+        let rd32 = |at: usize| (at as *const u32).read_unaligned() as usize;
+        let nt = base + rd32(base + 0x3c);
+        // IMAGE_DIRECTORY_ENTRY_EXCEPTION (3) of a PE32+ optional header.
+        let (dir, len) = (rd32(nt + 0x18 + 0x70 + 3 * 8), rd32(nt + 0x18 + 0x70 + 3 * 8 + 4));
+        if dir == 0 || dir + len > size {
+            return Vec::new();
+        }
+        let mut out = Vec::new();
+        for i in 0..len / 12 {
+            let (start, end) = (rd32(base + dir + i * 12), rd32(base + dir + i * 12 + 4));
+            if start == 0 || end <= start || end > size || end - start > 0x4000 {
+                continue;
+            }
+            let code = std::slice::from_raw_parts((base + start) as *const u8, end - start);
+            if let Some(hash) = handler_hash(code) {
+                out.push((start, hash));
+            }
+        }
+        out
+    }
+}
+
+/// Jenkins one-at-a-time over the lower-cased text (RAGE's string hash).
+pub fn joaat(text: &str) -> u32 {
+    let mut h: u32 = 0;
+    for b in text.bytes() {
+        let b = if b == b'\\' { b'/' } else { b.to_ascii_lowercase() };
+        h = h.wrapping_add(u32::from(b));
+        h = h.wrapping_add(h << 10);
+        h ^= h >> 6;
+    }
+    h = h.wrapping_add(h << 3);
+    h ^= h >> 11;
+    h.wrapping_add(h << 15)
+}
+
+/// The stub the patched site calls: `lea rcx, [rsp+0B0h]` (the context: the
+/// title's `[rsp+0A8h]` seen past our return address) ; `mov rdx, r15` (the
+/// handler) ; `mov r8, rbp` (the script context) ; `vzeroupper` ;
+/// `jmp [rip+0]` ; the address of [`dispatch`].
+fn stub_code(dispatch: usize) -> Vec<u8> {
+    let mut c = vec![0x48, 0x8d, 0x8c, 0x24, 0xb0, 0, 0, 0, 0x4c, 0x89, 0xfa, 0x49, 0x89, 0xe8, 0xc5, 0xf8, 0x77, 0xff, 0x25, 0, 0, 0, 0];
+    c.extend(dispatch.to_le_bytes());
+    c
+}
+
+/// The bytes for the site: `call stub` and a nine-byte NOP.
+fn site_code(site: usize, stub: usize) -> Option<[u8; 14]> {
+    let rel = i32::try_from(stub as i64 - (site as i64 + 5)).ok()?;
+    let mut c = [0xe8, 0, 0, 0, 0, 0x66, 0x0f, 0x1f, 0x84, 0, 0, 0, 0, 0];
+    c[1..5].copy_from_slice(&rel.to_le_bytes());
+    Some(c)
+}
+
+/// `VICTORY_NATIVES`: finds the handlers and hooks the NATIVE opcode.
+///
+/// # Safety
+/// `base` is the just-mapped title executable of `size` bytes whose original
+/// BLAKE3 is `hash`; no title code has run.
+#[cfg(windows)]
+pub(crate) unsafe fn install(base: usize, size: usize, hash: &blake3::Hash) {
+    use windows_sys::Win32::System::Memory::{PAGE_EXECUTE_READ, VirtualProtect};
+    TITLE_BASE.store(base, Ordering::Relaxed);
+    let Ok(mode) = std::env::var(ENV) else { return };
+    if mode.is_empty() || mode == "0" {
+        return;
+    }
+    if !hash.to_hex().starts_with(BUILD_1_0_2_1) {
+        tracing::warn!("{ENV}: not the 1.0.2.1 executable; no natives hook");
+        return;
+    }
+    // SAFETY: the mapped image.
+    let found = unsafe { scan(base, size) };
+    if found.len() != HANDLERS_1_0_2_1 {
+        tracing::warn!(found = found.len(), expected = HANDLERS_1_0_2_1, "{ENV}: an unexpected number of native handlers");
+    }
+    // SAFETY: inside the mapped .text of this exact build.
+    let now = unsafe { std::slice::from_raw_parts((base + SITE) as *const u8, SITE_BYTES.len()) };
+    if now != SITE_BYTES {
+        tracing::warn!(rva = format_args!("{SITE:#x}"), "{ENV}: the NATIVE opcode's call is not the expected bytes; no natives hook");
+        return;
+    }
+    let stub = stub_code(dispatch as *const () as usize);
+    let Some(place) = near_image(base, size, 0x1000) else {
+        tracing::warn!("{ENV}: no memory near the image for the stub; no natives hook");
+        return;
+    };
+    let Some(new) = site_code(base + SITE, place) else {
+        tracing::warn!("{ENV}: the stub is too far from the image; no natives hook");
+        return;
+    };
+    // SAFETY: `place` is a fresh page of ours; the site's bytes were checked.
+    unsafe {
+        std::ptr::copy_nonoverlapping(stub.as_ptr(), place as *mut u8, stub.len());
+        let mut old = 0;
+        VirtualProtect(place as _, 0x1000, PAGE_EXECUTE_READ, &mut old);
+    }
+    let names = read_names();
+    let state = State {
+        base,
+        size,
+        by_hash: found.iter().map(|&(rva, h)| (h, rva)).collect(),
+        by_rva: found.iter().copied().collect(),
+        names,
+        started: Instant::now(),
+        queue: Mutex::new(Queue { next_id: 1, ..Queue::default() }),
+        trace: Mutex::new(Trace::default()),
+    };
+    let names = state.names.len();
+    if STATE.set(state).is_err() {
+        return;
+    }
+    TRACING.store(mode == "trace" || mode == "log", Ordering::Relaxed);
+    LOGGING.store(mode == "log", Ordering::Relaxed);
+    if let Ok(spec) = std::env::var(WATCHMEM_ENV) {
+        match set_memwatch(&spec) {
+            Ok(text) => tracing::info!("{WATCHMEM_ENV}: {text}"),
+            Err(e) => tracing::warn!("{WATCHMEM_ENV}: {e}"),
+        }
+    }
+    // SAFETY: the bytes are the ones checked above; no title code runs yet.
+    if !unsafe { crate::hooks::write((base + SITE) as *mut u8, &new) } {
+        tracing::warn!("{ENV}: the NATIVE opcode's call could not be written");
+        return;
+    }
+    tracing::info!(
+        handlers = found.len(),
+        names,
+        site = format_args!("{SITE:#x}"),
+        old = ?SITE_BYTES,
+        new = ?new,
+        stub = format_args!("{place:#x}"),
+        trace = mode == "trace",
+        "{ENV}: natives hook applied (the NATIVE opcode's call goes through the layer; `ncall` runs natives on the script thread)"
+    );
+}
