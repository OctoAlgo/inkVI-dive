+/// LOCAL (octo, inkVI-dive): a stage a mission registered.
+#[derive(Clone, Debug, PartialEq)]
+pub struct TableStage {
+    pub stage: u32,
+    /// How many items (distinct `MISSION_STAGE_ITEM` keys) the title asked for under this stage.
+    pub items: u32,
+    /// How many times the stage was registered (more than once after a retry or a restart).
+    pub regs: u32,
+}
+
+/// The stages one mission (its script hash) registered, in order of first registration.
+#[derive(Clone, Debug, PartialEq)]
+pub struct StageTable {
+    pub mission: u32,
+    pub stages: Vec<TableStage>,
+    keys: HashSet<u64>,
+}
+
+/// What the channel should log: a stage registered (`stage` = its index in the table, `again` = not the first time),
+/// or the table's summary (`stage` None) once the registrations paused.
+#[derive(Clone, Debug, PartialEq)]
+pub struct TableNews {
+    pub mission: u32,
+    pub stage: Option<usize>,
+    pub again: bool,
+}
+
+impl StageTable {
+    /// A table for tests: (stage, items, registrations).
+    pub fn for_test(mission: u32, stages: &[(u32, u32, u32)]) -> Self {
+        let stages = stages.iter().map(|&(stage, items, regs)| TableStage { stage, items, regs }).collect();
+        StageTable { mission, stages, keys: HashSet::new() }
+    }
+}
+
+#[derive(Default)]
+struct Tables {
+    /// In order of first registration; the last one is the mission that registered last.
+    all: Vec<StageTable>,
+    news: Vec<TableNews>,
+    last: Option<Instant>,
+    summarised: bool,
+}
+static TABLES: Mutex<Tables> = Mutex::new(Tables { all: Vec::new(), news: Vec::new(), last: None, summarised: true });
+const TABLES_MAX: usize = 64;
+const KEYS_MAX: usize = 1 << 16;
+
+#[cfg(windows)]
+fn note_table_stage(arg: u64, mission: u32) {
+    let (stage, mut t) = (arg as u32, lock(&TABLES));
+    let at = match t.all.iter().position(|m| m.mission == mission) {
+        Some(i) => i,
+        None if t.all.len() < TABLES_MAX => {
+            t.all.push(StageTable { mission, stages: Vec::new(), keys: HashSet::new() });
+            t.all.len() - 1
+        }
+        None => return,
+    };
+    let last = t.all.len() - 1;
+    t.all.swap(at, last); // the mission that registers is the running one
+    let (idx, again) = match t.all[last].stages.iter().position(|s| s.stage == stage) {
+        Some(i) => {
+            t.all[last].stages[i].regs += 1;
+            (i, true)
+        }
+        None => {
+            t.all[last].stages.push(TableStage { stage, items: 0, regs: 1 });
+            (t.all[last].stages.len() - 1, false)
+        }
+    };
+    t.news.push(TableNews { mission, stage: Some(idx), again });
+    t.last = Some(Instant::now());
+    t.summarised = false;
+}
+
+#[cfg(windows)]
+fn note_table_item(key: u64, mission: u32) {
+    let mut t = lock(&TABLES);
+    let Some(m) = t.all.iter_mut().find(|m| m.mission == mission) else { return };
+    if m.keys.len() < KEYS_MAX && m.keys.insert(key) {
+        if let Some(s) = m.stages.iter_mut().find(|s| s.stage == (key >> 32) as u32) {
+            s.items += 1;
+        }
+    }
+}
+
+/// The stage tables so far (the running mission's is the last).
+pub fn stage_tables() -> Vec<StageTable> {
+    lock(&TABLES).all.clone()
+}
+
+/// Whether stages are seen being registered (the hook is on and `MISSION_STAGE_ADD` is named).
+pub fn table_hooked() -> bool {
+    STATE.get().is_some_and(|st| st.add_rva != 0)
+}
+
+/// The news since the last call; the summary comes once no stage was registered for `quiet`.
+pub fn table_news(quiet: std::time::Duration) -> Vec<TableNews> {
+    let mut t = lock(&TABLES);
+    let mut news = std::mem::take(&mut t.news);
+    if !t.summarised && t.last.is_some_and(|l| l.elapsed() >= quiet) {
+        t.summarised = true;
+        if let Some(m) = t.all.last() {
+            news.push(TableNews { mission: m.mission, stage: None, again: false });
+        }
+    }
+    news
+}
