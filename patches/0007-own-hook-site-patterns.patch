+/// The executable sections of a PE32+ image (mapped or as a file: `rva = true` gives their RVAs and virtual
+/// sizes, `false` their file offsets and raw sizes), as `(start, len)` pairs within `image`.
+pub fn exec_sections(image: &[u8], rva: bool) -> Vec<(usize, usize)> {
+    let rd16 = |at: usize| image.get(at..at + 2).map_or(0, |b| u16::from_le_bytes([b[0], b[1]]) as usize);
+    let rd32 = |at: usize| image.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]) as usize);
+    let nt = rd32(0x3c);
+    let (count, opt) = (rd16(nt + 6), rd16(nt + 0x14));
+    let first = nt + 0x18 + opt;
+    (0..count)
+        .filter_map(|i| {
+            let h = first + i * 40;
+            let (vsize, va, raw, ptr, ch) = (rd32(h + 8), rd32(h + 12), rd32(h + 16), rd32(h + 20), rd32(h + 36));
+            let (start, len) = if rva { (va, vsize) } else { (ptr, raw) };
+            (ch & 0x2000_0000 != 0 && start + len <= image.len() && len > 0).then_some((start, len))
+        })
+        .collect()
+}
+
+/// `pattern` exactly once over the executable sections of `image`: its position, else `Err(count)`.
+pub fn find_in_code(image: &[u8], rva: bool, pattern: &[Option<u8>]) -> Result<usize, usize> {
+    let mut found = None;
+    for (start, len) in exec_sections(image, rva) {
+        match find_unique(&image[start..start + len], pattern) {
+            Ok(at) if found.is_none() => found = Some(start + at),
+            Ok(_) | Err(2..) => return Err(2),
+            Err(_) => {}
+        }
+    }
+    found.ok_or(0)
+}
