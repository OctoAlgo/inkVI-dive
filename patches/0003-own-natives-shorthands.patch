+            v.push("GET_ENTITY_HEADING >_hdg $_ped".to_string());
+        }
+        v.extend(["GET_CLOCK_HOURS >_h", "GET_CLOCK_MINUTES >_m", "GET_CLOCK_SECONDS >_s"].map(String::from));
+        v
+    };
