+        assert!(e.run("pokef 0x10000 1.5").starts_with("wrote 1 floats"));
+        assert!(e.run("chain img+0x100 8").starts_with("chain set"));
+        assert!(e.run("matrix 0x60").starts_with("matrix offsets set"));
+        assert!(e.run("nonsense").starts_with("error: unknown"));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
