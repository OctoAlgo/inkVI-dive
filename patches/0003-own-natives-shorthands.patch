+/// What a shorthand command (`pos`, `tp`, `time`, `date`, `tpsave`, `tpgo`) reports once its last call has run.
+#[derive(Clone, Debug, PartialEq)]
+pub enum After {
+    /// One line: position, heading (degrees), clock.
+    Pos,
+    /// The clock.
+    Time,
+    /// The calendar date.
+    Date,
+    /// The position line, also written to the bookmarks file under `name`.
+    Save { name: String, file: std::path::PathBuf },
+}
+
+/// One teleport bookmark: a line `name x y z heading pitch [hh:mm]` (the debug channel's bookmarks file).
+#[derive(Clone, Debug, PartialEq)]
+pub struct Mark {
+    pub name: String,
+    pub pos: [f32; 3],
+    pub heading: f32,
+    pub time: Option<(u32, u32)>,
+}
+
+impl Mark {
+    pub fn parse(line: &str) -> Option<Mark> {
+        let mut f = line.split_whitespace();
+        let name = f.next()?.to_string();
+        if name.starts_with('#') {
+            return None;
+        }
+        let mut num = || f.next()?.parse::<f32>().ok();
+        let pos = [num()?, num()?, num()?];
+        let heading = num().unwrap_or(0.0);
+        let _pitch = num();
+        let time = f.next().and_then(|t| {
+            let (h, m) = t.split_once(':')?;
+            Some((h.parse().ok()?, m.parse().ok()?))
+        });
+        Some(Mark { name, pos, heading, time })
+    }
+
+    pub fn line(&self) -> String {
+        let mut s = format!("{} {:.3} {:.3} {:.3} {:.2} 0.00", self.name, self.pos[0], self.pos[1], self.pos[2], self.heading);
+        if let Some((h, m)) = self.time {
+            s.push_str(&format!(" {h:02}:{m:02}"));
+        }
+        s
+    }
+}
+
+/// The bookmarks file: `VICTORY_DEBUG_BOOKMARKS`, else `bookmarks.txt` in the channel's folder.
+fn marks_file(folder: &std::path::Path) -> std::path::PathBuf {
+    std::env::var_os("VICTORY_DEBUG_BOOKMARKS").map_or_else(|| folder.join("bookmarks.txt"), std::path::PathBuf::from)
+}
+
+/// The file's text with `mark` in place of a bookmark of the same name (other lines, comments too, are kept).
+pub fn with_mark(text: &str, mark: &Mark) -> String {
+    let mut out: String = text.lines().filter(|l| Mark::parse(l).is_none_or(|m| m.name != mark.name)).map(|l| format!("{l}\n")).collect();
+    out.push_str(&mark.line());
+    out.push('\n');
+    out
+}
+
+/// The line a finished shorthand command reports, from the variables its calls stored
+/// (`_pos`, `_hdg`, `_h`, `_m`, `_s`); `Save` also writes the bookmark.
+fn finish(vars: &HashMap<String, Vec<u64>>, after: &After) -> String {
+    let f = |v: u64| f32::from_bits(v as u32);
+    let pos = vars.get("_pos").filter(|v| v.len() >= 2).map(|v| [f(v[0]), f(v[0] >> 32), f(v[1])]);
+    // The title's heading natives work in radians (0 to 2 pi); the commands and the bookmarks in degrees.
+    let heading = vars.get("_hdg").and_then(|v| v.first()).map(|v| f(*v).to_degrees());
+    let int = |name: &str| vars.get(name).and_then(|v| v.first()).map(|v| *v as u32);
+    let clock = match (int("_h"), int("_m")) {
+        (Some(h), Some(m)) => Some((h, m, int("_s").unwrap_or(0))),
+        _ => None,
+    };
+    let time = clock.map_or("time ?".to_string(), |(h, m, s)| format!("time {h:02}:{m:02}:{s:02}"));
+    if *after == After::Time {
+        return time;
+    }
+    if *after == After::Date {
+        // The title counts months from 0 (as its date setter does); the command and the reply from 1.
+        return match (int("_dd"), int("_dm"), int("_dy")) {
+            (Some(d), Some(m), Some(y)) => format!("date {d} {} {y}", m + 1),
+            _ => "date ?".to_string(),
+        };
+    }
+    let Some(p) = pos else { return "pos ? (no position came back)".to_string() };
+    let line = format!("pos {:.3} {:.3} {:.3} heading {} {time}", p[0], p[1], p[2], heading.map_or("?".to_string(), |h| format!("{h:.2}")));
+    match after {
+        After::Save { name, file } => {
+            let mark = Mark { name: name.clone(), pos: p, heading: heading.unwrap_or(0.0), time: clock.map(|(h, m, _)| (h, m)) };
+            let text = with_mark(&std::fs::read_to_string(file).unwrap_or_default(), &mark);
+            match std::fs::write(file, text) {
+                Ok(()) => format!("saved `{}` in {}: {line}", mark.line(), file.display()),
+                Err(e) => format!("error: {}: {e} ({line})", file.display()),
+            }
+        }
+        _ => line,
+    }
 }
 
