+#[cfg(windows)]
+struct Channel {
+    folder: PathBuf,
+    exec: Executor<live::Process>,
+    later: Vec<(u64, String)>,
+    /// Lines run for the current `cmd` so far (for `done`).
+    replies: Vec<String>,
+}
+
+#[cfg(windows)]
+fn channel() -> Option<&'static Mutex<Channel>> {
+    static CHANNEL: OnceLock<Option<Mutex<Channel>>> = OnceLock::new();
+    CHANNEL
+        .get_or_init(|| {
+            let folder = PathBuf::from(std::env::var_os("VICTORY_DEBUG")?);
+            if !folder.is_absolute() {
+                tracing::warn!(folder = %folder.display(), "VICTORY_DEBUG is not a full path: no command channel");
+                return None;
+            }
+            if let Err(e) = std::fs::create_dir_all(&folder) {
+                tracing::warn!(error = %e, folder = %folder.display(), "the VICTORY_DEBUG folder could not be made: no command channel");
+                return None;
+            }
+            let exec = Executor::new(live::Process, &folder);
+            tracing::info!(folder = %folder.display(), base = format_args!("{:#x}", exec.mem.image_base()), ?exec.settings,
+                "debug command channel on (VICTORY_DEBUG): lines of the file `cmd` run every fourth present; replies in reply.txt");
+            Some(Mutex::new(Channel { folder, exec, later: Vec::new(), replies: Vec::new() }))
+        })
+        .as_ref()
+}
+
+/// At the present of `frame`, on the thread that presents.
+#[cfg(windows)]
+pub(crate) fn present(frame: u64) {
+    let Some(ch) = channel() else { return };
+    let mut ch = ch.lock().unwrap_or_else(|e| e.into_inner());
+    let world = crate::iterate::world_frame();
+    let mut run_now: Vec<String> = Vec::new();
+    if !ch.later.is_empty() {
+        let (due, wait): (Vec<_>, Vec<_>) = std::mem::take(&mut ch.later).into_iter().partition(|(n, _)| world.is_some_and(|w| w >= *n));
+        ch.later = wait;
+        run_now.extend(due.into_iter().map(|(_, c)| c));
+    }
+    let mut new_cmd = false;
+    if frame.is_multiple_of(4) {
+        let cmd = ch.folder.join("cmd");
+        if let Ok(text) = std::fs::read_to_string(&cmd) {
+            match std::fs::remove_file(&cmd) {
+                Ok(()) => {
+                    let _ = std::fs::remove_file(ch.folder.join("done"));
+                    ch.replies.clear();
+                    new_cmd = true;
+                    let (now, later) = schedule(&text, world);
+                    run_now.extend(now);
+                    ch.later.extend(later);
+                }
+                Err(e) => tracing::warn!(error = %e, "VICTORY_DEBUG: `cmd` could not be removed; not run"),
+            }
+        }
+    }
+    if run_now.is_empty() && !new_cmd {
+        return;
+    }
+    let stamp = format!("present {frame} world {}", world.map_or("-".to_string(), |w| w.to_string()));
+    for line in run_now {
+        let began = std::time::Instant::now();
+        let reply = ch.exec.run(&line);
+        let ms = began.elapsed().as_millis();
+        tracing::info!(cmd = %line, ms, "VICTORY_DEBUG: {}", reply.lines().next().unwrap_or(""));
+        ch.replies.push(format!("[{stamp}] > {line}\n{reply}\n"));
+    }
+    let text: String = ch.replies.concat();
+    let _ = std::fs::write(ch.folder.join("reply.txt"), &text);
+    if let Ok(mut log) = std::fs::OpenOptions::new().append(true).create(true).open(ch.folder.join("log.txt")) {
+        use std::io::Write as _;
+        let _ = log.write_all(text.as_bytes());
+    }
+    if ch.later.is_empty() {
+        let _ = std::fs::write(ch.folder.join("done"), format!("{stamp}\n"));
+    }
+}
