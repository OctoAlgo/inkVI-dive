+fn note_scene(st: &State, name: u64, flags: u64, obj: u64, script: u32) {
+    if obj == 0 {
+        return;
+    }
+    let mut scenes = lock(&st.scenes);
+    scenes.retain(|s| s.obj != obj);
+    if scenes.len() >= SCENES_MAX {
+        scenes.remove(0);
+    }
+    scenes.push(Scene { name: name as u32, flags, obj, script, ms: st.started.elapsed().as_millis() as u64 });
 }
 
