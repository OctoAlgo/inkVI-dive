+/// The lines of a `cmd` file split into those that run now and those that
+/// wait for a world frame (`@w<N> ...`).
+pub(crate) fn schedule(text: &str, world: Option<u64>) -> (Vec<String>, Vec<(u64, String)>) {
+    let mut now = Vec::new();
+    let mut later = Vec::new();
+    for line in text.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        if let Some(rest) = line.strip_prefix("@w") {
+            if let Some((n, cmd)) = rest.split_once(char::is_whitespace) {
+                if let Ok(n) = n.parse::<u64>() {
+                    if world.is_some_and(|w| w >= n) {
+                        now.push(cmd.trim().to_string());
+                    } else {
+                        later.push((n, cmd.trim().to_string()));
+                    }
+                    continue;
+                }
+            }
+        }
+        now.push(line.to_string());
+    }
+    (now, later)
+}
